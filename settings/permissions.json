{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(app/**)",
      "Edit(apps/**)",
      "Edit(packages/**)",
      "Edit(crates/**)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm test *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm build *)",
      "Bash(pnpm -r test *)",
      "Bash(pnpm -r typecheck *)",
      "Bash(pnpm -r lint *)",
      "Bash(pnpm -r build *)",
      "Bash(npm ci)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run lint *)",
      "Bash(npm run build *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:nodejs.org)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git checkout *)",
      "Bash(git clean *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm dlx *)",
      "Bash(npm install *)",
      "Bash(npx *)",
      "Bash(cargo add *)",
      "Bash(curl *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(git * --no-verify*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/secrets/**)"
    ]
  }
}
